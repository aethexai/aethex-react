# Copy to .env and fill in. EXPO_PUBLIC_* is exposed to the app bundle, which is
# fine here: the token-mint URL and agent id are not secrets. The ae_live_ API
# key stays on your server (the mint route) and never appears in the app.
#
# TOKEN_URL is a tiny server route that mints an ephemeral call token. The
# cloudflare-proxy example in this repo exposes it at POST /token.
EXPO_PUBLIC_AETHEX_TOKEN_URL=https://your-worker.example.workers.dev/token
EXPO_PUBLIC_AETHEX_AGENT_ID=11111111-1111-1111-1111-111111111111
