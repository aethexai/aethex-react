# Copy to `.env.local` and fill in your values.

# Your Aethex API key (ae_live_...). Server-side only: it never reaches the
# browser. The app/api/aethex route uses it to mint short-lived call tokens.
AETHEX_API_KEY=ae_live_...

# The agent id to call (from your Aethex dashboard).
NEXT_PUBLIC_AETHEX_AGENT_ID=your-agent-id
